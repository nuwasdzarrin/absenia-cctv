# Salin file ini menjadi ".env" lalu isi nilai aslinya.
# JANGAN commit .env ke git (sudah di-ignore).

# --- Kamera Tapo (hanya perlu bila camera.source = "rtsp" di config.yaml) ---
# Camera Account dibuat di app Tapo > Advanced Settings > Camera Account.
TAPO_RTSP_USER=isi_username_camera_account
TAPO_RTSP_PASS=isi_password_camera_account
TAPO_IP=192.168.1.100

# --- Google Sheet via Apps Script Web App ---
# URL Web App hasil Deploy dari apps_script/Code.gs
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Kata sandi rahasia; harus SAMA dengan var TOKEN di apps_script/Code.gs
APPS_SCRIPT_TOKEN=ganti_dengan_token_rahasia
